; Parallels X Old 3DS perspective world shader.
; World geometry is authored in shared data and shaded into the vertex colors
; on the CPU. This shader performs only the shared camera transforms and color
; pass-through so the PICA200 workload remains predictable.

.fvec projection[4], view[4]

.constf constants(0.0, 1.0, 0.0, 0.0)
.alias ones constants.yyyy

.out outpos position
.out outclr color

.in inpos v0
.in inclr v1

.proc main
    mov r0.xyz, inpos
    mov r0.w, ones

    dp4 r1.x, view[0], r0
    dp4 r1.y, view[1], r0
    dp4 r1.z, view[2], r0
    dp4 r1.w, view[3], r0

    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    mov outclr, inclr
    end
.end
